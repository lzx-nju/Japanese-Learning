      "points": [
        {
          "kind": "grammar",
          "title": "～の～（……用的……）",
          "blocks": [
            {
              "t": "p",
              "text": "「名词 + の + 名词」表示用途、所属或性质。照片里最典型的一处就是「お肌**の**虫よけ」。"
            },
            {
              "t": "ul",
              "items": [
                "お肌**の**虫よけ ＝ 肌肤用的驱蚊液",
                "子供**の**虫よけ ＝ 孩子用的驱蚊液",
                "虫よけ**スプレー** ＝ 驱蚊喷雾（名词叠加成复合词）",
                "私**の**もの ＝ 我的东西（所属）"
              ]
            }
          ]
        },
        {
          "kind": "pattern",
          "title": "～用 / ～タイプ / ～にやさしい",
          "blocks": [
            {
              "t": "ul",
              "items": [
                "子供**用** ＝ 儿童用的",
                "ミスト**タイプ** ＝ 喷雾型",
                "お肌**にやさしい** ＝ 对肌肤温和"
              ]
            }
          ]
        }
      ]
    }
  ],
  "summary": {
    "points": [
      "**～の～** — ……的……（用途、所属、性质）",
      "**～用** — 供……用的（子供用、大人用）",
      "**～タイプ** — ……型（ミストタイプ）",
      "**お＋名词** — 美化语（お肌、お水）"
    ],
    "words": [
      "虫よけ",
      "スプレー",
      "ミスト",
      "お肌",
      "子供用",
      "成分",
      "使う"
    ]
  },
